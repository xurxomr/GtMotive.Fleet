<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <EntityFrameworkVersion>10.0.0</EntityFrameworkVersion>
        <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Microsoft Extensions -->
        <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Update="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />

        <!-- Entity Framework Core + PostgreSQL (Npgsql) -->
        <PackageReference Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(EntityFrameworkVersion)" />
        <PackageReference Update="Npgsql" Version="$(EntityFrameworkVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkVersion)" PrivateAssets="All" />

        <!-- Transitive security override: EF Core Design -> MSBuild tasks pull a vulnerable 9.0.0. -->
        <PackageReference Update="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="All"/>
        <!-- Serilog -->
        <PackageReference Update="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Update="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Update="Serilog.Settings.Configuration" Version="9.0.0" />
        <PackageReference Update="Serilog.Sinks.Console" Version="6.0.0" />

        <!-- Swagger -->
        <PackageReference Update="Swashbuckle.AspNetCore" Version="9.0.6" />

        <!-- MediatR -->
        <PackageReference Update="MediatR" Version="10.0.1" />
        <PackageReference Update="MediatR.Extensions.Microsoft.DependencyInjection" Version="10.0.1" />

        <!-- Resilience -->
        <PackageReference Update="Polly" Version="8.5.0" />

        <!-- Testing -->
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Update="xunit" Version="2.9.2" />
        <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageReference Update="FluentAssertions" Version="7.0.0" />
        <PackageReference Update="coverlet.collector" Version="6.0.2" />
        <PackageReference Update="Microsoft.AspNetCore.TestHost" Version="$(EntityFrameworkVersion)" />
        <PackageReference Update="Respawn" Version="6.2.1" />
        <PackageReference Update="Moq" Version="4.20.72" />
        <PackageReference Update="Testcontainers.PostgreSql" Version="4.6.0" />

        <!-- Transitive security override: Testcontainers pulls a vulnerable SSH.NET 2024.2.0. -->
        <PackageReference Update="SSH.NET" Version="2026.0.0" PrivateAssets="All" />

        <!-- Third-party analyzers -->
        <PackageReference Update="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageReference Update="SonarAnalyzer.CSharp" Version="10.6.0.109712" />
    </ItemGroup>

</Project>
